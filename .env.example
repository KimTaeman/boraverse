# Example names only. Copy to .env.local and replace with real, private values.
# NEVER commit .env.local or any real credential.
NEXT_PUBLIC_SITE_URL=https://YOUR-FINAL-HTTPS-URL.example
DATABASE_URL=postgresql://YOUR_POOLER_USER:YOUR_PASSWORD@YOUR_REAL_POOLER_HOST:6543/postgres
# Optional path to the trusted Supabase database CA certificate.
DATABASE_CA_CERT_PATH=
OCEAN_HMAC_SECRET=REPLACE_WITH_LONG_RANDOM_SERVER_ONLY_SECRET
OCEAN_WRITE_ENABLED=false
# Optional only if bot challenge is deliberately introduced later:
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
